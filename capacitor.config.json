{
  "appId": "com.scadenze.app",
  "appName": "ScadenzeApp",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "url": "https://mimmoclaude.github.io/ScadenzeApp/"
  },
  "ios": {
    "contentInset": "automatic"
  },
  "android": {
    "buildOptions": {
      "keystorePath": null,
      "keystoreAlias": null,
      "keystoreAliasPassword": null,
      "keystorePassword": null,
      "signingType": "jarsigner"
    }
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "Preferences": {
      "group": "ScadenzeApp"
    }
  }
}
